{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch clang-dxc",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/bin/clang-dxc",
      "args": [
        "${input:hlslFile}",
        "-T",
        "cs_6_8",
        "-spirv"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false
    }
  ],
  "inputs": [
    {
      "type": "promptString",
      "id": "hlslFile",
      "description": "Path to your hlsl file to test",
      "default": ""
    }
  ]
}